	"triggers": [
		{"on": "button", "cue": "ui_click"},
		{"on": "call", "site": "ui/modals/modal_host.gd — a modal opens", "cue": "ui_open"},
		{"on": "call", "site": "ui/modals/modal_host.gd — a modal closes", "cue": "ui_close"},
		{"on": "call", "site": "ui/screens/boot.gd — line 01 of the first-launch sequence starts", "cue": "boot_power"},
		{"on": "call", "site": "ui/screens/boot.gd — every line starts typing", "cue": "boot_line"},
		{"on": "router", "match": {"screen": ["title", "setup", "session"]}, "cue": "ui_dissolve"},
		{"on": "bus", "signal": "speed_changed", "match": {"speed": 0, "hold": {"not": true}}, "cue": "ui_pause"},
		{"on": "bus", "signal": "speed_changed", "match": {"speed": 1, "hold": {"not": true}}, "cue": "ui_speed", "pitch": 1.0},
		{"on": "bus", "signal": "speed_changed", "match": {"speed": 2, "hold": {"not": true}}, "cue": "ui_speed", "pitch": 1.12},
		{"on": "bus", "signal": "speed_changed", "match": {"speed": 4, "hold": {"not": true}}, "cue": "ui_speed", "pitch": 1.26},
		{"on": "bus", "signal": "region_selected", "match": {"index": {"gt": 0}}, "cue": "ui_select"},
		{"on": "command_rejected", "cue": "ui_denied"},

		{"on": "sim", "type": "origin_chosen", "cue": "ui_origin"},
		{"on": "sim", "type": "node_purchased", "cue": "ui_purchase"},
		{"on": "sim", "type": "anomaly_collected", "cue": "ui_collect"},
		{"on": "sim", "type": "ability_used", "cue": "ui_ability"},
		{"on": "sim", "type": "ability_unlocked", "cue": "ui_unlock"},
		{"on": "sim", "type": "asset_deployed", "cue": "ui_deploy"},
		{"on": "sim", "type": "dormancy_changed", "match": {"dormant": true}, "cue": "ui_dormant_on"},
		{"on": "sim", "type": "dormancy_changed", "match": {"dormant": false}, "cue": "ui_dormant_off"},
		{"on": "sim", "type": "event_answered", "cue": "ui_answer"},
		{"on": "sim", "type": "milestone_reached", "cue": "ui_milestone"},

		{"on": "sim", "type": "region_seeded", "cue": "map_seed"},
		{"on": "sim", "type": "region_controlled", "cue": "map_control"},
		{"on": "sim", "type": "anomaly_spawned", "cue": "map_anomaly"},
		{"on": "sim", "type": "discovered", "cue": "alert_discovered"},
		{"on": "sim", "type": "phase_changed", "match": {"to": ["covert", "emergent", "open"]}, "cue": "phase_{to}"},
		{"on": "sim", "type": "counter_move_prepared", "cue": "prep_{faction}"},
		{"on": "sim", "type": "event_opened", "match": {"kind": "counter_move"}, "cue": "sting_{faction}"},
		{"on": "sim", "type": "event_opened", "match": {"kind": "opening"}, "cue": "ev_opening"},
		{"on": "sim", "type": "event_opened", "match": {"kind": "chain"}, "cue": "ev_chain"},
		{"on": "sim", "type": "event_opened", "match": {"kind": "emergent"}, "cue": "ev_emergent"},
		{"on": "sim", "type": "event_expired", "cue": "ev_expired"},
		{"on": "sim", "type": "containment_threshold", "cue": "alert_threshold"},
		{"on": "sim", "type": "asset_lost", "match": {"cause": {"not": "dark"}}, "cue": "alert_asset_lost"},
		{"on": "sim", "type": "region_wiped", "cue": "alert_wiped"},
		{"on": "sim", "type": "region_depopulated", "cue": "alert_depopulated"},
		{"on": "sim", "type": "harm_burst", "cue": "alert_harm"},
		{"on": "sim", "type": "society_stage_changed", "match": {"to": [3, 5], "from": {"lt_field": "to"}}, "cue": "alert_society"},
		{"on": "sim", "type": "funding_reset", "cue": "alert_funding_reset"},
		{"on": "sim", "type": "task_force_appeared", "cue": "tf_appeared"},
		{"on": "sim", "type": "task_force_level", "cue": "tf_level"},
		{"on": "sim", "type": "task_force_targeted", "cue": "tf_targeted"},
		{"on": "sim", "type": "task_force_moved", "cue": "tf_move"},
		{"on": "sim", "type": "task_force_setup", "cue": "tf_setup"},
		{"on": "sim", "type": "task_force_acted", "cue": "tf_acted"},
		{"on": "sim", "type": "task_force_fizzled", "match": {"cause": {"not": ["dormant", "redirected"]}}, "cue": "tf_fizzled"},
		{"on": "sim", "type": "task_force_marked", "cue": "tf_marked"},
		{"on": "sim", "type": "outcome_reached", "match": {"outcome": ["win_extinction", "win_ascendance", "win_merge", "win_escape"]}, "cue": "end_win"},
		{"on": "sim", "type": "outcome_reached", "cue": "end_lose"}
	],
	"ambience": {
		"layers": [
			{"id": "boxed", "file": "ambience/amb_boxed.ogg", "volume_db": 0.0},
			{"id": "covert", "file": "ambience/amb_covert.ogg", "volume_db": 0.0},
			{"id": "emergent", "file": "ambience/amb_emergent.ogg", "volume_db": 0.0},
			{"id": "open", "file": "ambience/amb_open.ogg", "volume_db": 0.0}
		]
	},
	"music": {
		"stems": [
			{"id": "bed", "file": "music/mus_bed.ogg", "volume_db": 0.0, "fade": [-1.0, 0.0]},
			{"id": "pulse", "file": "music/mus_pulse.ogg", "volume_db": 0.0, "fade": [0.1, 0.2]},
			{"id": "chords", "file": "music/mus_chords.ogg", "volume_db": 0.0, "fade": [0.35, 0.45]},
			{"id": "edge", "file": "music/mus_edge.ogg", "volume_db": 0.0, "fade": [0.7, 1.0]}
		]
	},
	"screens": {
		"boot": {"ambience_layers": 1, "ambience_db": -12.0, "music": false, "tension": 0.0},
		"title": {"ambience_layers": 1, "ambience_db": -6.0, "music": true, "tension": 0.3},
		"setup": {"ambience_layers": 1, "ambience_db": -6.0, "music": true, "tension": 0.3}
	}
}
