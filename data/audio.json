{
	"_comment": "docs/specs/audio.md §4: the buses, the cue sheet, the triggers, the ambience layers and the music stems. Read by AudioSheet (ui/audio/audio_sheet.gd, S6.5), never by the core. Files are paths under res://assets/audio/; the sounds are made by tools/audio/synth.py from tools/audio/recipes.json (S6.6).",
	"version": 1,
	"buses": [
		{"id": "master", "send": "", "default_volume": 1.0, "limiter_db": -1.0},
