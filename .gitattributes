# Normalize line endings for all text files
* text=auto eol=lf

# Godot text formats
*.gd text
*.tscn text
*.tres text
*.godot text
*.cfg text
*.import text
*.uid text
*.gdshader text
*.csv text
*.json text

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
