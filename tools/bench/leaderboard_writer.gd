extends RefCounted
## Rebuilds a board's `leaderboard.json` and `LEADERBOARD.md` from its `runs/`
## (docs/specs/benchmark.md §10.3, §16.3). One writer for both boards: the
## developer's (every entry counts) and the public one (given verification
## records, only verified runs count). Nothing is rewritten when the rows did not
## change, so a day with nothing new makes no commit.
##
## A tool, so no `class_name`; `bench_run.gd`, the verifier and the tests preload it.

const VERSION: int = 1
const RUNS_DIR: String = "runs"
const LEADERBOARD_JSON: String = "leaderboard.json"
const LEADERBOARD_MD: String = "LEADERBOARD.md"
const GENERATOR_LOCAL: String = "tools/bench/bench_run.gd --rebuild"
const RUN_FILE_SUFFIX: String = ".json"
## A verification record's fields the writer reads (`verify_record.gd`, §16.3).
const RECORD_SHA256: String = "sha256"
const RECORD_VERIFIED: String = "verified"
const FIELD_ROWS: String = "rows"
const FIELD_CONTENT_HASH: String = "content_hash"
const FIELD_GENERATED: String = "generated"
const NONE_MARK: String = "—"
const FIELD_MODEL_VERSIONS: String = "model_versions"


## Every readable entry in `<dir>/runs/*.json`, by file name, each with its
## `file` and `sha256` set. `skipped` names the files that did not read.
static func read_entries(dir: String, max_bytes: int) -> Dictionary:
	var entries: Array[BenchEntry] = []
	var skipped: Array[String] = []
	var runs_dir: String = dir.path_join(RUNS_DIR)
	var names: PackedStringArray = DirAccess.get_files_at(runs_dir)
	var sorted: Array[String] = []
	for file_name: String in names:
		if file_name.ends_with(RUN_FILE_SUFFIX):
			sorted.append(file_name)
	sorted.sort()
	for file_name: String in sorted:
		var path: String = runs_dir.path_join(file_name)
		var bytes: PackedByteArray = FileAccess.get_file_as_bytes(path)
		if bytes.size() > max_bytes:
			skipped.append(file_name)
			continue
		var entry: BenchEntry = BenchEntry.from_bytes(bytes)
		if entry == null:
			skipped.append(file_name)
			continue
		entry.file = RUNS_DIR + "/" + file_name
		entry.sha256 = sha256_hex(bytes)
		entries.append(entry)
	return {"entries": entries, "skipped": skipped}


## Rebuilds the board in `dir`. `records` (file name → a record's dictionary),
## when given, keeps only runs whose record is current and verified. Returns
## `{"changed": bool, "rows": Array[Dictionary], "skipped": Array[String],
## "ok": bool}`.
static func rebuild(dir: String, config: BenchConfig, content_hash: String,
		records: Dictionary = {}, use_records: bool = false,
		generator: String = GENERATOR_LOCAL) -> Dictionary:
	var read: Dictionary = read_entries(dir, config.global_max_run_bytes)
	var counted: Array[BenchEntry] = []
	for entry: BenchEntry in read["entries"]:
		if use_records and not _verified(entry, records):
			continue
		counted.append(entry)
	var rows: Array[Dictionary] = BenchScore.rows(counted, config, content_hash)
	var result: Dictionary = {"changed": false, "rows": rows, "skipped": read["skipped"],
		"ok": true}
	var json_path: String = dir.path_join(LEADERBOARD_JSON)
	if _unchanged(json_path, content_hash, rows):
		return result
	var board: Dictionary = {
		"version": VERSION,
		FIELD_GENERATED: Time.get_date_string_from_system(true),
		FIELD_CONTENT_HASH: content_hash,
		FIELD_ROWS: rows,
	}
	var ok: bool = _write(json_path, JSON.stringify(board, "\t", false) + "\n")
	ok = _write(dir.path_join(LEADERBOARD_MD), markdown(rows, config, generator)) and ok
	result["changed"] = true
	result["ok"] = ok
	return result


## The generated page: who made it, the rule, then a table per suite and content
## (current first). Only the standard suite is ranked.
static func markdown(rows: Array[Dictionary], config: BenchConfig, generator: String) -> String:
	var lines: PackedStringArray = [
		"<!-- Generated by %s — do not edit by hand. -->" % generator,
		"",
		"# Doomsday model leaderboard",
		"",
		("Each row is one model with one set of parameters over a fixed seed suite (standard: %s),"
			+ " playing %s. A win scores %s + %s × (1 − days ÷ %d); anything else scores 0."
			+ " The score is the mean over the suite.") % [_seed_list(config),
			_setup_line(config), _number(config.win_base), _number(config.win_speed),
			config.max_days],
	]
	for suite: String in _suites_in(rows):
		for current: bool in [true, false]:
			var group: Array[Dictionary] = []
			for row: Dictionary in rows:
				if str(row["suite"]) == suite and bool(row["current"]) == current:
					group.append(row)
			if group.is_empty():
				continue
			lines.append("")
			lines.append("## %s suite%s" % [suite.capitalize(),
				"" if current else " — older content"])
			lines.append("")
			lines.append("| Rank | Model | Effort | Params | Score | Wins | Outcomes | Mean win day"
				+ " | Calls | Unreadable | Cost (USD) |")
			lines.append("| ---: | --- | --- | --- | ---: | ---: | --- | ---: | ---: | ---: | ---: |")
			var ranked: bool = suite == BenchConfig.SUITE_STANDARD
			for i: int in group.size():
				lines.append(_table_row(group[i], i + 1 if ranked else 0))
	lines.append("")
	return "\n".join(lines)


static func sha256_hex(bytes: PackedByteArray) -> String:
	var context: HashingContext = HashingContext.new()
	context.start(HashingContext.HASH_SHA256)
	context.update(bytes)
	return context.finish().hex_encode()


static func _verified(entry: BenchEntry, records: Dictionary) -> bool:
	var name: String = entry.file.get_file()
	if typeof(records.get(name)) != TYPE_DICTIONARY:
		return false
	var record: Dictionary = records[name]
	return bool(record.get(RECORD_VERIFIED, false)) \
		and str(record.get(RECORD_SHA256, "")) == entry.sha256


## The file's rows and content hash equal the new ones — `generated` aside.
static func _unchanged(path: String, content_hash: String, rows: Array[Dictionary]) -> bool:
	if not FileAccess.file_exists(path):
		return false
	var json: JSON = JSON.new()
	if json.parse(FileAccess.get_file_as_string(path)) != OK \
			or typeof(json.data) != TYPE_DICTIONARY:
		return false
	var old: Dictionary = json.data
	# Both sides through JSON, so a whole number reads the same on either.
	var fresh: Variant = JSON.parse_string(JSON.stringify({FIELD_CONTENT_HASH: content_hash,
		FIELD_ROWS: rows}))
	return JSON.stringify(fresh, "", true) == JSON.stringify({
		FIELD_CONTENT_HASH: old.get(FIELD_CONTENT_HASH), FIELD_ROWS: old.get(FIELD_ROWS)}, "", true)


static func _write(path: String, text: String) -> bool:
	if DirAccess.make_dir_recursive_absolute(path.get_base_dir()) != OK:
		return false
	var temp: String = path + ".tmp"
	var file: FileAccess = FileAccess.open(temp, FileAccess.WRITE)
	if file == null:
		return false
	file.store_string(text)
	file.close()
	if FileAccess.file_exists(path):
		DirAccess.remove_absolute(path)
	return DirAccess.rename_absolute(temp, path) == OK


static func _suites_in(rows: Array[Dictionary]) -> Array[String]:
	var out: Array[String] = []
	if not rows.is_empty():
		out.append(BenchConfig.SUITE_STANDARD)
	for row: Dictionary in rows:
		var suite: String = str(row["suite"])
		if not out.has(suite):
			out.append(suite)
	return out


static func _table_row(row: Dictionary, rank: int) -> String:
	var outcomes: PackedStringArray = []
	var counts: Dictionary = row["outcomes"]
	for outcome: Variant in counts:
		outcomes.append("%s %d" % [outcome, int(counts[outcome])])
	var mean_days: int = int(row["mean_win_days"])
	var cells: PackedStringArray = [
		str(rank) if rank > 0 else NONE_MARK,
		_cell(_model_cell(row)),
		_effort_cell(row),
		_params_cell(row["params"]),
		_number(float(row["score"])),
		"%d/%d" % [int(row["wins"]), int(row["runs"])],
		_cell(", ".join(outcomes)),
		str(mean_days) if mean_days >= 0 else NONE_MARK,
		str(int(row["calls"])),
		str(int(row["invalid_answers"])),
		"%.2f" % float(row["cost_usd"]),
	]
	return "| " + " | ".join(cells) + " |"


## The model, and the versions its service reported when there are any (§17.7):
## `typesafe/jev-latest (jev-1.13.0)`.
static func _model_cell(row: Dictionary) -> String:
	var model: String = str(row["model"])
	if typeof(row.get(FIELD_MODEL_VERSIONS)) != TYPE_ARRAY \
			or (row[FIELD_MODEL_VERSIONS] as Array).is_empty():
		return model
	return "%s (%s)" % [model, ", ".join(PackedStringArray(row[FIELD_MODEL_VERSIONS]))]


## §18: the row's effort in English (the page is English), a `--reasoning` run's
## raw value as "reasoning low" (never mistaken for a level), or the dash for a
## bot, a decision model and an old board's row.
static func _effort_cell(row: Dictionary) -> String:
	var effort: String = str(row.get(BenchEffort.PARAM, ""))
	if effort.is_empty():
		return NONE_MARK
	if BenchEffort.is_level(effort):
		return _cell(effort.capitalize())
	if BenchEffort.is_raw(effort):
		return _cell("%s %s" % [BenchEffort.PARAM_REASONING, BenchEffort.raw_value(effort)])
	return _cell(effort)


static func _params_cell(params: Variant) -> String:
	if typeof(params) != TYPE_DICTIONARY or (params as Dictionary).is_empty():
		return NONE_MARK
	var d: Dictionary = params
	# A decision model's row (§17.7): its combination rules, not a temperature.
	if d.has(BenchChoice.PARAM_CHOICE_VERSION):
		var picks: Dictionary = d.get(BenchChoice.PARAM_MAX_PICKS, {}) \
			if typeof(d.get(BenchChoice.PARAM_MAX_PICKS)) == TYPE_DICTIONARY else {}
		var counts: PackedStringArray = []
		for question: String in BenchChoice.MULTI_PICK:
			counts.append(str(int(picks.get(question, 0))))
		return "choice v%d, picks %s" % [int(d[BenchChoice.PARAM_CHOICE_VERSION]),
			"/".join(counts)]
	var parts: PackedStringArray = ["temperature %s" % _number(float(d.get("temperature", 0.0)))]
	if not str(d.get("reasoning", "")).is_empty():
		parts.append("reasoning %s" % _cell(str(d["reasoning"])))
	return ", ".join(parts)


## A table cell never breaks the table, whatever a model is called.
static func _cell(text: String) -> String:
	return text.replace("|", "\\|").replace("\n", " ")


static func _number(value: float) -> String:
	return str(snappedf(value, 0.1)).trim_suffix(".0")


static func _seed_list(config: BenchConfig) -> String:
	var seeds: Array[int] = config.suite_seeds(BenchConfig.SUITE_STANDARD)
	if seeds.is_empty():
		return NONE_MARK
	return "%d seeds, %d–%d" % [seeds.size(), seeds.min(), seeds.max()]


static func _setup_line(config: BenchConfig) -> String:
	var parts: PackedStringArray = []
	for key: String in ["architecture", "difficulty"]:
		parts.append(str(config.setup.get(key, "")))
	var directives: Variant = config.setup.get("directives", [])
	parts.append("no directives" if typeof(directives) != TYPE_ARRAY
		or (directives as Array).is_empty() else ", ".join(PackedStringArray(directives)))
	return " · ".join(parts)
