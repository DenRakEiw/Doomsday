[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/modals/pause_menu.gd" id="1_pause"]
[ext_resource type="Script" path="res://ui/components/console_button.gd" id="2_console_button"]
[ext_resource type="Script" path="res://ui/components/caps_label.gd" id="3_caps_label"]
[ext_resource type="PackedScene" path="res://ui/modals/confirm_modal.tscn" id="4_confirm"]
[ext_resource type="Script" path="res://ui/components/modal_panel.gd" id="9_modal_panel"]

[node name="PauseMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pause")

[node name="Centre" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="PausePanel" type="PanelContainer" parent="Centre"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ConsolePanel"
script = ExtResource("9_modal_panel")

[node name="Scroll" type="ScrollContainer" parent="Centre/PausePanel"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Centre/PausePanel/Scroll"]
