[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/hud/status_strip.gd" id="1_status_strip"]
[ext_resource type="Script" path="res://ui/components/chip.gd" id="2_chip"]
[ext_resource type="Script" path="res://ui/components/icon_button.gd" id="3_icon_button"]

[node name="StatusStrip" type="PanelContainer"]
custom_minimum_size = Vector2(0, 56)
theme_type_variation = &"ConsolePanelRaised"
script = ExtResource("1_status_strip")

[node name="StripRows" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StackTight"

[node name="Body" type="HBoxContainer" parent="StripRows"]
layout_mode = 2
theme_type_variation = &"Row"

[node name="StripRow" type="HBoxContainer" parent="StripRows/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"RowSnug"

[node name="StripChip" type="PanelContainer" parent="StripRows/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"Chip"
script = ExtResource("2_chip")

[node name="StripMenu" type="Button" parent="StripRows/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"IconButton"
script = ExtResource("3_icon_button")
glyph = 12
tooltip_key = "UI_MENU_TITLE"
