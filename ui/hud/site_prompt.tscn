[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/hud/site_prompt.gd" id="1_site_prompt"]
[ext_resource type="Script" path="res://ui/components/console_button.gd" id="2_console_button"]

[node name="SitePrompt" type="PanelContainer"]
custom_minimum_size = Vector2(640, 0)
size_flags_horizontal = 4
theme_type_variation = &"ConsolePanelRaised"
script = ExtResource("1_site_prompt")

[node name="Body" type="VBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"StackTight"

[node name="SitePromptTitle" type="Label" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"LabelHeading"

[node name="SitePromptDetail" type="Label" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"LabelCaption"

[node name="SiteCancel" type="Button" parent="Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"ConsoleButton"
script = ExtResource("2_console_button")
label_key = "UI_SITE_CANCEL"
