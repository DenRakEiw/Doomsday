[node name="ContinueDay" type="Label" parent="Centre/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelCaption"

[node name="SettingsButton" type="Button" parent="Centre/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ConsoleButton"
script = ExtResource("2_console_button")
label_key = "UI_TITLE_SETTINGS"

[node name="QuitButton" type="Button" parent="Centre/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ConsoleButton"
script = ExtResource("2_console_button")
label_key = "UI_TITLE_QUIT"

[node name="TitleFailure" type="Label" parent="Centre/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
