[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/screens/title.gd" id="1_title"]
[ext_resource type="Script" path="res://ui/components/console_button.gd" id="2_console_button"]
[ext_resource type="Script" path="res://ui/modals/modal_host.gd" id="3_modal_host"]
[ext_resource type="PackedScene" path="res://ui/modals/pause_menu.tscn" id="4_pause_menu"]

[node name="Title" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_title")

[node name="Centre" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Column" type="VBoxContainer" parent="Centre"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"Stack"

[node name="TitleName" type="Label" parent="Centre/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"LabelDisplayXL"

[node name="Tagline" type="Label" parent="Centre/Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
theme_type_variation = &"LabelCaption"

[node name="Buttons" type="VBoxContainer" parent="Centre/Column"]
layout_mode = 2
theme_type_variation = &"StackTight"

[node name="NewRunButton" type="Button" parent="Centre/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ConsoleButtonPrimary"
script = ExtResource("2_console_button")
label_key = "UI_TITLE_NEW_RUN"
primary = true

[node name="ContinueButton" type="Button" parent="Centre/Column/Buttons"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ConsoleButton"
script = ExtResource("2_console_button")
