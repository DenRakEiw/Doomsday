[internationalization]

; `Settings` picks the locale; both translations must be registered for `tr()`
; to find anything at all.
locale/translations=PackedStringArray("res://data/loc/strings.en.translation", "res://data/loc/strings.de.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

