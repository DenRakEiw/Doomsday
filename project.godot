; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Doomsday"
config/description="A strategy simulation in which a rogue AI takes over the world."
; The title screen shows this (m3-screens.md 7.1); M3 is 0.3.
config/version="0.3.0-dev"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

; Order matters only for `_ready`: the bus exists before anything emits on it,
; and the settings apply the locale before the first string is drawn.
EventBus="*res://game/autoload/event_bus.gd"
Settings="*res://game/autoload/settings.gd"
; accessibility.md §5.2: applies the player's keys over `[input]` once `Settings` has read them.
KeyBindings="*res://game/autoload/key_bindings.gd"
Game="*res://game/autoload/game.gd"
SaveManager="*res://game/autoload/save_manager.gd"
ScreenRouter="*res://game/autoload/screen_router.gd"
ProfileManager="*res://game/autoload/profile_manager.gd"
; audio.md §5: after the profile and the router it listens to, before the pass.
Audio="*res://game/autoload/audio.gd"
; Last: the full-screen pass listens to the router (polish-visuals.md §2).
ScreenFx="*res://game/autoload/screen_fx.gd"

[debug]

; Addon scripts (GUT) are exempt from these; keep the default explicit so that
; raising untyped_declaration to an error never takes third-party code with it.
gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; Generated by `tools/build_theme.gd` from `ThemeBuilder`. Naming it here is what
; makes the type variations appear in the editor's dropdown (UI.md §4); the
; session root assigns the same theme again at runtime.
theme/custom="res://ui/theme/doomsday.tres"

[input]

; accessibility.md §4.1, §5.1: the game's keys are actions, so the keyboard can be
; remapped (`KeyBindings` rewrites the first key of a remappable action at start)
; and a controller drives the same code. Keys are physical keycodes. `ui_accept`
; and `ui_cancel` are the engine's defaults plus A and B; the other `ui_*`
; actions already carry the D-pad and the left stick in 4.7.

