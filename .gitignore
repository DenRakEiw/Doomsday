# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
*.translation
export_credentials.cfg

# Exported builds. `build/.gdignore` is committed so the editor never imports
# an export's files as project resources (web.md §3.3).
/build/*
!/build/.gdignore
/export/

# MCP / AI tooling (local, may contain machine-specific paths)
.mcp.json
.claude/settings.local.json
.claude/worktrees/

# godot-mcp injects this autoload into the project while a run is in progress
# and removes it on stop; a crashed run can leave it behind.
/mcp_interaction_server.gd
/mcp_interaction_server.gd.uid

# Python: the map pipeline's environment and caches. uv.lock is committed, the
# environment it describes is not.
.venv/
__pycache__/
*.pyc

# Node (MCP server, if placed inside the project)
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp

# Icons: the downloaded set archives (tools/icons/vendor_icons.py) and the PNG
# atlas, a build product switched on per export (docs/specs/icons.md §10).
tools/icons/.cache/
/assets/icons/atlas/

# The benchmark's answer cache (docs/specs/benchmark.md §9): local, never committed.
/benchmark/cache/
